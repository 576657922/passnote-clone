{
  "name": "passnote-clone",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "IPA 考试刷题平台复刻（IT パスポート / 基本情報 / SG / AP）— 含全部 Pro 会员功能",
  "scripts": {
    "seed": "node server/seed.js",
